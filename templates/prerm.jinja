#!/bin/sh

set -e

RULEFILE={{ rules_path }}
BACKUP_RULES_FILE={{ backup_rules_path }}
{%- macro clean_python_bytecode() %}
        # Python writes bytecode next to the modules when they are imported.
        # dpkg does not know these files and keeps the directory holding them.
        if command -v py3clean >/dev/null 2>&1; then
            py3clean -p {{ debian_package_name }} \
                || echo "warning: py3clean failed (exit $?), continuing" >&2
        fi
{%- endmacro %}

# Removal must always be possible: a failing plugin must not leave the
# package stuck half-installed, so rules failures are reported but not fatal.
case "$1" in
    remove)
        if [ -x "${RULEFILE}" ]; then
            # the rules file is shipped by the package: keep a copy so the
            # postrm action can still run once the package files are gone
            mkdir -p "${BACKUP_RULES_FILE%/*}"
            cp -f "${RULEFILE}" "${BACKUP_RULES_FILE}" \
                || echo "warning: could not back up ${RULEFILE}" >&2
            "${RULEFILE}" uninstall \
                || echo "warning: plugin uninstall failed (exit $?), continuing" >&2
        else
            echo "warning: ${RULEFILE} not found, skipping plugin uninstall" >&2
        fi
        {%- if ships_python|default(false) %}
        # after the uninstall action: it can import the plugin again
        {{- clean_python_bytecode() }}
        {%- endif %}
    ;;

    upgrade)
        {%- if ships_python|default(false) %}
        {{- clean_python_bytecode() }}
        {%- else %}
        :
        {%- endif %}
    ;;

    deconfigure|failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
